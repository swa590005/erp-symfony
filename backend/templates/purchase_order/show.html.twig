{% extends 'base.html.twig' %}

{% block title %}Hello {{ controller_name | default('ERP') }}{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">

    <ul>
        <li>Order Number : {{ purchaseOrder.orderNumber }}</li>
        <li>Order Date : {{ purchaseOrder.orderDate |date("d.m.Y", false) }}</li>
        <li>Order Status : {{ purchaseOrder.status.value }}</li>
        <li>Order Supplier Name : {{ purchaseOrder.supplier.supplierName }}</li>
        <li>Order Supplier Email : {{ purchaseOrder.supplier.emailAddress }}</li>
    </ul>
    <table style="width: 100%; border: 1px solid #ccc" >
        <tr style="background-color: #eee">
            <th>Article Name</th>
            <th>Article Number</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total</th>
        </tr>
        {% for line in totals.linesTotal %}
            <tr>
                <td>{{ line.name }}</td>
                <td>{{ line.articleNumber }}</td>
                <td>{{ line.quantity }}</td>
                <td> € {{ line.unitPrice|number_format(2, ',', '.') }}</td>
                <td> € {{ line.lineTotal|number_format(2, ',', '.') }}</td>
            </tr>
        {% endfor %}
        <tr>
            <td>Gross Total</td>
            <td></td>
            <td></td>
            <td></td>
            <td>€ {{ totals.grossTotal|number_format(2, ',', '.') }}</td>
        </tr>
    </table>
</div>
{% endblock %}
